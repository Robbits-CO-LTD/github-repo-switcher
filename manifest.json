{
  "manifest_version": 3,
  "name": "Repo Signal — GitHub Issue Switcher",
  "short_name": "Repo Signal",
  "version": "0.1.0",
  "description": "お気に入りリポジトリのGitHub Issuesを1クリックで行き来できます。",
  "icons": {
    "16": "icons/repo-signal-16.png",
    "32": "icons/repo-signal-32.png",
    "48": "icons/repo-signal-48.png",
    "128": "icons/repo-signal-128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*"
      ],
      "js": [
        "src/repositories.generated.js",
        "src/shared.js",
        "src/styles.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
